{
  "name": "desktop-pet-suite",
  "version": "1.0.0",
  "description": "Windows 10/11 x64 人物桌面宠物",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js test/assets/*.test.js",
    "build:win:x64": "electron-builder --win nsis:x64"
  },
  "devDependencies": {
    "electron": "41.10.4",
    "electron-builder": "26.15.7"
  },
  "dependencies": {
    "koffi": "2.16.3"
  },
  "build": {
    "appId": "local.person.desktop.pet",
    "productName": "人物桌宠",
    "win": {
      "artifactName": "Person-Desktop-Pet-Setup-${version}-${arch}.${ext}",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "人物桌宠"
    },
    "files": [
      "src/**/*",
      "assets/animations/manifest.json",
      "assets/animations/sheets/idle.png",
      "assets/animations/sheets/crawl.png",
      "assets/animations/sheets/kneel.png",
      "assets/animations/sheets/sit.png",
      "assets/animations/sheets/hang.png",
      "assets/animations/sheets/wall-climb.png",
      "assets/animations/sheets/drag.png",
      "assets/animations/sheets/fall.png",
      "assets/animations/sheets/land.png"
    ]
  }
}
